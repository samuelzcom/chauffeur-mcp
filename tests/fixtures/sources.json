      { "name": "Pending Directory", "status": "planned", "evidence_url": "https://pending.test" }
    ]
  },
  "initialize": {
    "protocolVersion": "2025-03-26",
    "serverInfo": { "name": "example-customer", "version": "2.2.0" },
