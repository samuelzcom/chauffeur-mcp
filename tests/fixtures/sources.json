      { "label": "Vienna city", "timeZone": "Europe/Vienna", "areas": [{ "label": "Vienna Airport", "timeZone": "Europe/Vienna" }] }
    ]
  },
  "registry": {
    "servers": [
      {
        "server": { "name": "io.example/provider", "version": "0.1.0" },
        "_meta": { "io.modelcontextprotocol.registry/official": { "isLatest": false } }
      },
      {
        "server": {
          "name": "io.example/provider",
          "title": "Example registry title",
          "description": "Example registry description.",
          "version": "1.1.0",
          "websiteUrl": "https://live.test/docs",
          "icons": [{ "src": "https://live.test/logo.png" }],
          "remotes": [{ "type": "streamable-http", "url": "https://example.test/mcp" }]
        },
        "_meta": { "io.modelcontextprotocol.registry/official": { "isLatest": true } }
