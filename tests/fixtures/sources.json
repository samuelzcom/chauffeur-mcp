    "docsUrl": "https://fallback.test/docs",
    "license": "MIT",
    "copyrightHolder": "Example Organization",
    "repo": "example/mirror",
    "endpointVariants": [
      { "id": "full", "path": "" },
      { "id": "quote-only", "path": "/quote-only" },
      { "id": "info-only", "path": "/info-only" }
    ]
  },
  "openapi": {
