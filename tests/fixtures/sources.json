  "tools": [
    { "name": "read_options", "title": "Read options", "description": "Published options | current areas.\nNo booking.", "annotations": { "readOnlyHint": true } },
    { "name": "prepare_request", "description": "Prepare a request only with consent.", "annotations": { "readOnlyHint": false } }
